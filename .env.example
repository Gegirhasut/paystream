# Static key expected in the X-API-Key header
API_KEY=change-me

POSTGRES_USER=payments
POSTGRES_PASSWORD=payments
POSTGRES_DB=payments

RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# Host ports
API_PORT=8000
POSTGRES_PORT=5432
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
WEBHOOK_RECEIVER_PORT=8080

# Payment emulation
PROCESSING_MIN_DELAY=2
PROCESSING_MAX_DELAY=5
PROCESSING_SUCCESS_RATE=0.9
GATEWAY_TIMEOUT=30

# Retries: total attempts and the base of the exponential backoff (seconds)
RETRY_MAX_ATTEMPTS=3
RETRY_BASE_DELAY=2
WEBHOOK_TIMEOUT=5
# Key of the HMAC signature (X-Webhook-Signature) the merchant verifies
WEBHOOK_SECRET=change-me-webhook-secret
# Host names webhooks may reach inside the internal network (SSRF protection
# refuses every other internal address); the demo receiver only
WEBHOOK_ALLOWED_INTERNAL_HOSTS=webhook-receiver
CONSUMER_PREFETCH_COUNT=10
# Seconds to finish in-flight messages on shutdown
CONSUMER_GRACEFUL_TIMEOUT=15
# How often the consumer checks that RabbitMQ has not dropped its subscription
CONSUMER_WATCHDOG_INTERVAL=15

# PostgreSQL ends a session idle inside a transaction for this long (frees row locks
# of a frozen worker); a single statement may take at most DB_COMMAND_TIMEOUT
DB_IDLE_IN_TRANSACTION_TIMEOUT=120
DB_COMMAND_TIMEOUT=180

# Recovery of stalled payments (lost messages): a payment without progress for
# RECOVERY_AFTER seconds is dispatched again, at most RECOVERY_MAX_ATTEMPTS times
RECOVERY_AFTER=600
RECOVERY_INTERVAL=60
RECOVERY_MAX_ATTEMPTS=5

# Outbox relay
OUTBOX_POLL_INTERVAL=0.5
OUTBOX_BATCH_SIZE=100
OUTBOX_PUBLISH_TIMEOUT=10
# Published outbox rows are deleted after this many hours
OUTBOX_RETENTION_HOURS=24
OUTBOX_CLEANUP_INTERVAL=300

LOG_LEVEL=INFO
